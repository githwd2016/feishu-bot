{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": { "type": "string", "enum": ["success", "blocked"] },
    "action": { "type": "string", "enum": ["inspect", "review", "address_feedback"] },
    "prUrl": { "type": "string" },
    "unresolvedCount": { "type": "integer", "minimum": 0 },
    "unresolvedReviewerLogins": {
      "type": "array",
      "items": { "type": "string" }
    },
    "commentsPosted": { "type": "integer", "minimum": 0 },
    "commentsReplied": { "type": "integer", "minimum": 0 },
    "commentsResolved": { "type": "integer", "minimum": 0 },
    "commitSha": { "type": ["string", "null"] },
    "summary": { "type": "string" },
    "blockers": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": [
    "status",
    "action",
    "prUrl",
    "unresolvedCount",
    "unresolvedReviewerLogins",
    "commentsPosted",
    "commentsReplied",
    "commentsResolved",
    "commitSha",
    "summary",
    "blockers"
  ]
}
