# Feishu application credentials
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
BOT_NAME=张三bot

# Enabled platforms: gitcode (default), github, or gitcode,github for one bot
# handling both platforms. Each enabled platform requires its own token/allowlist.
REPO_PROVIDERS=gitcode

# GitCode access token. Codex plugin and OpenCode helper both read it from the
# environment. Never commit the real token.
GITCODE_TOKEN=xxx
GITCODE_ALLOWED_REPOS=example-org/example-repo
GITCODE_API_BASE=https://api.gitcode.com/api/v5

# Required when REPO_PROVIDERS includes github. GitHub.com personal user PAT;
# use the same person as the Feishu bot identity. Git push credentials are separate.
# GITHUB_TOKEN=xxx
# GITHUB_ALLOWED_REPOS=example-org/example-repo
# GITHUB_API_BASE=https://api.github.com

# Main repository used only to create isolated temporary Git worktrees. Agents
# never run directly in this directory, so unrelated local files are preserved.
# In dual-platform mode unprefixed keys keep their GitCode meaning; use
# github:owner/repo for GitHub, including when both platforms have the same name.
# REPO_WORKDIRS_JSON={"example-org/example-repo":"/path/gitcode","github:example-org/example-repo":"/path/github"}
REPO_WORKDIRS_JSON={"example-org/example-repo":"/absolute/path/to/example-repo"}

# Unified person identity routing. Every participant must map their Feishu user
# open_id, GitCode login, and Feishu bot open_id. The current bot and
# GITCODE_TOKEN must resolve to the same entry at startup.
# commit_name is the list of local Git author names that should map to each
# GitCode login when generating the weekly report.
# In dual-platform mode add githubLogin to each participant using GitHub:
# {"displayName":"张三","feishuOpenId":"ou_zhangsan_user","gitcodeLogin":"zhangsan","githubLogin":"zhangsan-gh","botOpenId":"ou_zhangsan_bot"}
# The current bot must have a matching login for every enabled platform.
# Other participants may map only the platforms they use.
IDENTITY_MAPPINGS_JSON='[
  {"displayName":"张三","feishuOpenId":"ou_zhangsan_user","gitcodeLogin":"zhangsan","commit_name":["张三","zhangsan"],"botOpenId":"ou_zhangsan_bot"},
  {"displayName":"李四","feishuOpenId":"ou_lisi_user","gitcodeLogin":"lisi","commit_name":["李四","lisi"],"botOpenId":"ou_lisi_bot"}
]'

# Automatic PR scanning. Leave AUTO_REVIEW_CHAT_ID empty on first start, send
# "获取 chat_id" in the target group, then copy the returned value here.
AUTO_REVIEW_CHAT_ID=
PR_SCAN_INTERVAL_SECONDS=300

# Agent backend: codex or opencode.
AGENT_BACKEND=codex
AGENT_TIMEOUT_MS=1800000

# Codex backend: runs non-interactively and loads the installed GitCode plugin
# from normal Codex configuration. GitHub tasks use the bundled GitHub helper
# with either backend; no GitCode plugin is needed for GitHub-only deployment.
# Only enable bypass in a hardened VM.
CODEX_BIN=codex
CODEX_MODEL=
CODEX_PROFILE=
CODEX_BYPASS_APPROVALS_AND_SANDBOX=true

# OpenCode backend: uses the repository-allowlisted GitCode helper because the
# Codex GitCode plugin is not available inside OpenCode.
OPENCODE_BIN=opencode
OPENCODE_MODEL=
OPENCODE_AGENT=
OPENCODE_VARIANT=
OPENCODE_AUTO_APPROVE=true
MAX_REVIEW_CYCLES=3
STATE_FILE=./data/state.json
