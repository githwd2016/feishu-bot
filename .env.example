# Feishu application credentials
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
BOT_NAME=张三bot

# GitCode access token. Codex plugin and OpenCode helper both read it from the
# environment. Never commit the real token.
GITCODE_TOKEN=xxx
GITCODE_ALLOWED_REPOS=example-org/example-repo
GITCODE_API_BASE=https://api.gitcode.com/api/v5

# Main repository used only to create isolated temporary Git worktrees. Agents
# never run directly in this directory, so unrelated local files are preserved.
REPO_WORKDIRS_JSON={"example-org/example-repo":"/absolute/path/to/example-repo"}

# Review bots. "feishu" sends a real group @ and waits for that bot to @ back;
# "local" runs a logical reviewer inside this process for single-machine tests.
# openId comes from the target bot's startup log: [setup] BOT_OPEN_ID=ou_xxx.
REVIEWERS_JSON=[{"id":"lisi","name":"李四bot","openId":"ou_lisi_bot","gitcodeLogin":"lisi","mode":"feishu"}]

# Agent backend: codex or opencode.
AGENT_BACKEND=codex
AGENT_TIMEOUT_MS=1800000

# Codex backend: runs non-interactively and loads the installed GitCode plugin
# from normal Codex configuration. Only enable bypass in a hardened VM.
CODEX_BIN=codex
CODEX_MODEL=
CODEX_PROFILE=
CODEX_BYPASS_APPROVALS_AND_SANDBOX=true

# OpenCode backend: uses the repository-allowlisted GitCode helper because the
# Codex GitCode plugin is not available inside OpenCode.
OPENCODE_BIN=opencode
OPENCODE_MODEL=
OPENCODE_AGENT=
OPENCODE_VARIANT=
OPENCODE_AUTO_APPROVE=true
MAX_REVIEW_CYCLES=3
STATE_FILE=./data/state.json

# 首次启动并收到 owner 的测试消息后，再从机器人本机运行日志填写。
# 日志格式为：[setup] OWNER_OPEN_ID=ou_xxx。
# OWNER_NAME 仅用于机器人在群消息中 @ owner 时显示名称。
OWNER_OPEN_ID=
OWNER_NAME=
